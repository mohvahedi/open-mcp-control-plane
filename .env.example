# Open MCP Control Plane example environment
# Copy values into your local environment manager. Do not commit real secrets.

OPENMCP_HOST=0.0.0.0
OPENMCP_PORT=8080
OPENMCP_VERSION=dev
OPENMCP_DB_PATH=file:/var/lib/openmcp/openmcp.db?_pragma=busy_timeout(5000)
# Optional fixed bootstrap admin token. If empty, one is generated once at startup.
OPENMCP_BOOTSTRAP_ADMIN_TOKEN=
OPENMCP_REQUEST_TIMEOUT=10s
OPENMCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io
OPENMCP_REGISTRY_TIMEOUT=5s
OPENMCP_REGISTRY_PAGE_LIMIT=25
OPENMCP_USE_FAKE_RUNTIME=true
OPENMCP_DOCKER_BINARY=docker
OPENMCP_GATEWAY_PATH=/gateway

# CLI
OPENMCP_URL=http://127.0.0.1:8080
OPENMCP_TOKEN=
